{
  "name": "les",
  "version": "1.0.0",
  "description": "BroJS microfrontend hello world",
  "main": "./src/index.tsx",
  "scripts": {
    "start": "brojs server --port=8099 --with-open-browser",
    "build": "npm run clean && brojs build --dev",
    "build:prod": "npm run clean && brojs build",
    "clean": "rimraf dist",
    "compile": "brojs compile",
    "prom": "npm run compile && brojs prom-server --port=8099"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@brojs/cli": "^2.0.1",
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "express": "^4.19.2",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5"
  }
}
